# Postgres connection string. For local Postgres:
#   createdb onboarding_hub
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onboarding_hub?schema=public"

# 32+ char random string used to sign admin session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Default admin account, created by `npm run db:seed` if no admin exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"
